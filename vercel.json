{
  "framework": "vite",
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "functions": {
    "server/api/**/*.ts": {
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
